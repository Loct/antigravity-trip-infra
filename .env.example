# Wanderlog Session Authentication
# 1. Log in to https://wanderlog.com in your web browser.
# 2. Open Developer Tools (F12 or Cmd+Option+I) -> Application / Storage -> Cookies -> https://wanderlog.com
# 3. Copy the value of the 'connect.sid' cookie and paste it below:
WANDERLOG_AUTH_SESSION_COOKIE=

# Optional: Wanderlog XSRF Token (usually not required, but supported)
WANDERLOG_AUTH_SESSION_XSRF_TOKEN=

# Remote Control Configuration
# Automatically starts 'agy remote-control serve' daemon inside the container
ENABLE_REMOTE_CONTROL=true

# Multi-instance Configuration (Deploying multiple times on the same server)
# 1. Project name isolates Docker volumes, networks, and containers:
COMPOSE_PROJECT_NAME=gemini-wanderlog

# 2. Container name must be unique across all Docker containers on the host:
CONTAINER_NAME=antigravity-wanderlog

# 3. Remote Control Hostname displayed in Antigravity Web UI (https://antigravity.google.com/):
REMOTE_CONTROL_HOSTNAME=wanderlog-agent

# GitHub & Git Configuration (Optional)
# GitHub Personal Access Token (PAT) for GitHub CLI & git clone/push:
GH_TOKEN=
# GITHUB_TOKEN=

# Git Author details for commits made inside the container:
GIT_USER_NAME=
GIT_USER_EMAIL=

# Booking.com Configuration (Optional)
# Browser session cookie (e.g. bkng_sso_session from browser dev tools):
BOOKING_SESSION_COOKIE=

# Booking.com Developer / RapidAPI key for hotel search:
BOOKING_API_KEY=

# Apify Configuration (Optional - for Agoda & Google Maps lodging search)
# Personal API token from https://console.apify.com/account/integrations:
APIFY_TOKEN=

# Default Apify actor for Agoda scraping (e.g. tri_angle/agoda-scraper):
APIFY_AGODA_ACTOR=tri_angle/agoda-scraper

# Default Apify actor for Google Maps Places/Hotels (e.g. compass/crawler-google-places):
APIFY_GMAPS_ACTOR=compass/crawler-google-places

