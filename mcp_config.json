{
  "mcpServers": {
    "wanderlog": {
      "command": "wanderlog",
      "args": [
        "mcp",
        "--enable-write"
      ],
      "env": {
        "WANDERLOG_AUTH_SESSION_COOKIE": "${WANDERLOG_AUTH_SESSION_COOKIE}"
      }
    },
    "apify": {
      "serverUrl": "https://mcp.apify.com",
      "headers": {
        "Authorization": "Bearer ${APIFY_TOKEN}"
      }
    }
  }
}
